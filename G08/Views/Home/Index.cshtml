    <!-- JavaScript Logic -->
    <script>
        // Tab switching
        function switchTab(tabId) {
            document.querySelectorAll('.tab-content').forEach(el => el.classList.add('hidden'));
            document.querySelectorAll('.tab-btn').forEach(btn => {
                btn.classList.remove('bg-primary', 'text-white', 'shadow-sm');
                btn.classList.add('text-slate-600');
            });

            const targetTab = document.getElementById(tabId);
            if(targetTab) targetTab.classList.remove('hidden');

            const activeBtn = document.getElementById('btn-' + tabId);
            if(activeBtn) {
                activeBtn.classList.add('bg-primary', 'text-white', 'shadow-sm');
                activeBtn.classList.remove('text-slate-600');
            }
        }

        // Mobile menu toggle
        const mobileMenuBtn = document.getElementById('mobile-menu-btn');
        const mobileMenu = document.getElementById('mobile-menu');
        const menuIcon = document.getElementById('menu-icon');

        function toggleMobileMenu() {
            if (mobileMenu.classList.contains('hidden')) {
                mobileMenu.classList.remove('hidden');
                menuIcon.classList.remove('fa-bars');
                menuIcon.classList.add('fa-xmark');
            } else {
                mobileMenu.classList.add('hidden');
                menuIcon.classList.remove('fa-xmark');
                menuIcon.classList.add('fa-bars');
            }
        }

        if (mobileMenuBtn) {
            mobileMenuBtn.addEventListener('click', toggleMobileMenu);
        }

        document.querySelectorAll('.mobile-nav-link').forEach(link => {
            link.addEventListener('click', () => {
                if (!mobileMenu.classList.contains('hidden')) {
                    toggleMobileMenu();
                }
            });
        });

        // Catalog Filter
        function filterCatalog(category) {
            document.querySelectorAll('.cat-filter-btn').forEach(btn => {
                if(btn.dataset.category === category) {
                    btn.classList.add('bg-primary', 'text-white');
                    btn.classList.remove('bg-slate-100', 'text-slate-700');
                } else {
                    btn.classList.remove('bg-primary', 'text-white');
                    btn.classList.add('bg-slate-100', 'text-slate-700');
                }
            });

            document.querySelectorAll('.catalog-card').forEach(card => {
                if(category === 'all' || card.dataset.category === category) {
                    card.classList.remove('hidden');
                } else {
                    card.classList.add('hidden');
                }
            });
        }

        // Live Simulation Calculation
        function calculateSimulator() {
            const qty = parseInt(document.getElementById('sim-qty').value) || 1;
            const scenarioSelect = document.getElementById('sim-scenario');
            const unitPrice = parseFloat(scenarioSelect.value);
            const shippingSelect = document.getElementById('sim-shipping');
            const shippingCost = parseFloat(shippingSelect.value);

            document.getElementById('slider-qty-val').innerText = qty + ' Adet';

            // Constants:
            // 8 BileÅŸen ToplamÄ± = 2.700 â‚º
            // Montaj = 250 â‚º
            const componentCost = 2700;
            const assemblyCost = 250;
            const unitCost = componentCost + assemblyCost + shippingCost;
            const unitProfit = unitPrice - unitCost;

            const totalCost = unitCost * qty;
            const totalRevenue = unitPrice * qty;
            const totalProfit = unitProfit * qty;

            document.getElementById('sim-unit-cost').innerText = unitCost.toLocaleString('tr-TR') + ' â‚º';
            document.getElementById('sim-unit-price').innerText = unitPrice.toLocaleString('tr-TR') + ' â‚º';
            document.getElementById('sim-unit-profit').innerText = (unitProfit >= 0 ? '+' : '') + unitProfit.toLocaleString('tr-TR') + ' â‚º';

            document.getElementById('sim-total-cost').innerText = totalCost.toLocaleString('tr-TR') + ' â‚º';
            document.getElementById('sim-total-revenue').innerText = totalRevenue.toLocaleString('tr-TR') + ' â‚º';
            document.getElementById('sim-total-profit').innerText = (totalProfit >= 0 ? '+' : '') + totalProfit.toLocaleString('tr-TR') + ' â‚º';
        }

        // Transfer Simulator choice to Order Modal
        function transferSimToOrder() {
            const qty = document.getElementById('sim-qty').value;
            const scenarioValue = document.getElementById('sim-scenario').value;
            const shippingValue = document.getElementById('sim-shipping').value;

            openOrderModal('SmartBox AkÄ±llÄ± Ä°stasyon (TÃ¼m 8 BileÅŸen Dahil)', scenarioValue);
            document.getElementById('modal-quantity').value = qty;
            document.getElementById('modal-shipping-select').value = shippingValue;

            if (scenarioValue == '3658') {
                document.getElementById('modal-scenario-select').selectedIndex = 1;
            } else if (scenarioValue == '4960') {
                document.getElementById('modal-scenario-select').selectedIndex = 2;
            } else {
                document.getElementById('modal-scenario-select').selectedIndex = 0;
            }
            updateModalSummary();
        }

        function selectScenario(name, price, margin) {
            openOrderModal('SmartBox AkÄ±llÄ± Ä°stasyon (TÃ¼m 8 BileÅŸen Dahil)', price);
            if (price === 3658) document.getElementById('modal-scenario-select').selectedIndex = 1;
            else if (price === 4960) document.getElementById('modal-scenario-select').selectedIndex = 2;
            else document.getElementById('modal-scenario-select').selectedIndex = 0;
            updateModalSummary();
        }

        // Modal Logic
        const orderModal = document.getElementById('orderModal');

        function openOrderModal(productName = '', price = null) {
            orderModal.classList.remove('hidden');
            document.body.classList.add('modal-active');
            goToStep(1);

            if(productName) {
                const select = document.getElementById('modal-product-select');
                for (let i = 0; i < select.options.length; i++) {
                    if (select.options[i].text.includes(productName) || select.options[i].value.includes(productName)) {
                        select.selectedIndex = i;
                        break;
                    }
                }
            }
            updateModalSummary();
        }

        function closeOrderModal() {
            orderModal.classList.add('hidden');
            document.body.classList.remove('modal-active');
        }

        function goToStep(step) {
            document.getElementById('order-step-1').classList.add('hidden');
            document.getElementById('order-step-2').classList.add('hidden');
            document.getElementById('order-step-3').classList.add('hidden');
            document.getElementById('order-step-success').classList.add('hidden');

            const s1 = document.getElementById('step-dot-1');
            const s2 = document.getElementById('step-dot-2');
            const s3 = document.getElementById('step-dot-3');

            s1.className = "w-8 h-8 rounded-full font-bold text-xs flex items-center justify-center " + (step >= 1 ? "bg-primary text-white" : "bg-slate-200 text-slate-600");
            s2.className = "w-8 h-8 rounded-full font-bold text-xs flex items-center justify-center " + (step >= 2 ? "bg-primary text-white" : "bg-slate-200 text-slate-600");
            s3.className = "w-8 h-8 rounded-full font-bold text-xs flex items-center justify-center " + (step >= 3 ? "bg-primary text-white" : "bg-slate-200 text-slate-600");

            if(step === 1) document.getElementById('order-step-1').classList.remove('hidden');
            if(step === 2) document.getElementById('order-step-2').classList.remove('hidden');
            if(step === 3) document.getElementById('order-step-3').classList.remove('hidden');

            updateModalSummary();
        }

        function updateModalSummary() {
            const productSelect = document.getElementById('modal-product-select');
            const qty = parseInt(document.getElementById('modal-quantity').value) || 1;
            const scenarioSelect = document.getElementById('modal-scenario-select');

            let unitPrice = 0;
            if (productSelect.value.includes('SmartBox')) {
                const opt = scenarioSelect.options[scenarioSelect.selectedIndex];
                unitPrice = parseFloat(opt.getAttribute('data-unit')) || 4185;
            } else {
                const opt = productSelect.options[productSelect.selectedIndex];
                unitPrice = parseFloat(opt.getAttribute('data-price')) || 380;
            }

            const total = unitPrice * qty;

            document.getElementById('modal-sum-unit').innerText = unitPrice.toLocaleString('tr-TR') + ' â‚º';
            document.getElementById('modal-sum-qty').innerText = qty + ' Adet';
            document.getElementById('modal-sum-total').innerText = total.toLocaleString('tr-TR') + ' â‚º';
        }

        function submitFinalOrder() {
            const company = document.getElementById('cust-company').value.trim();
            const name = document.getElementById('cust-name').value.trim();
            const email = document.getElementById('cust-email').value.trim();

            if(!company || !name || !email) {
                alert('LÃ¼tfen ÅŸirket adÄ±, yetkili adÄ± ve e-posta alanlarÄ±nÄ± eksiksiz doldurunuz.');
                return;
            }

            const product = document.getElementById('modal-product-select').value;
            const qty = document.getElementById('modal-quantity').value;
            const total = document.getElementById('modal-sum-total').innerText;

            const randomCode = 'GP-2026-' + Math.floor(1000 + Math.random() * 9000);
            document.getElementById('res-tracking-id').innerText = randomCode;
            document.getElementById('res-product').innerText = product.split('(')[0];
            document.getElementById('res-amount').innerText = qty + ' Adet (' + total + ')';

            document.getElementById('order-step-3').classList.add('hidden');
            document.getElementById('order-step-success').classList.remove('hidden');
        }

        function handleContactSubmit(e) {
            e.preventDefault();
            alert('MesajÄ±nÄ±z GÃ¼vencePlus G08 kurumsal ekibine iletildi. En kÄ±sa sÃ¼rede dÃ¶nÃ¼ÅŸ saÄŸlanacaktÄ±r.');
            e.target.reset();
        }

        // Initialize Simulator and handle deep linking
        window.addEventListener('DOMContentLoaded', () => {
            calculateSimulator();
            
            const params = new URLSearchParams(window.location.search);
            const hash = window.location.hash;
            
            if (params.get('tab') || hash.includes('tab-')) {
                const tab = params.get('tab') ? ('tab-' + params.get('tab')) : hash.replace('#', '');
                switchTab(tab);
            }
            if (params.get('order') === 'true' || hash === '#order-modal') {
                openOrderModal();
            }
        });
    </script>
